# Required environment variables for the Answer Sheet Evaluator

# PaddleOCR API (get from https://aistudio.baidu.com/paddleocr/task)
PADDLEOCR_API_URL=https://your-paddleocr-api-url-here
PADDLEOCR_TOKEN=your-paddleocr-token-here

# Google Gemini API (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
